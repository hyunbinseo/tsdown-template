{
	"name": "tsdown-starter",
	"version": "0.0.0",
	"description": "A starter for creating a TypeScript package.",
	"homepage": "https://github.com/user/repo#readme",
	"bugs": {
		"url": "https://github.com/user/repo/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/user/repo.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"prepack": "tsdown",
		"version": "tsdown && git add package.json",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@types/node": "^24.13.3",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"oxlint-tsgolint": "^7.0.2001",
		"publint": "^0.3.24",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.3.4",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.20.0",
			"onFail": "download"
		}
	}
}
